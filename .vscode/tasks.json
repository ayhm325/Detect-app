{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Dev: Next.js",
			"type": "npm",
			"script": "dev:next",
			"isBackground": true,
			"problemMatcher": {
				"pattern": [
					{
						"regexp": ".",
						"file": 1,
						"location": 2,
						"message": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting|starting|Compiled successfully|ready - started",
					"endsPattern": "Local:",
					"timeout": 60000
				}
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Dev: Socket server",
			"type": "shell",
			"command": "npx cross-env NODE_ENV=development node scripts/socket-server.js",
			"isBackground": true,
			"problemMatcher": {
				"pattern": [
					{
						"regexp": ".",
						"file": 1,
						"location": 2,
						"message": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting socket|Socket.io server listening",
					"endsPattern": "Socket.io server listening",
					"timeout": 60000
				}
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "E2E: Playwright watch",
			"type": "npm",
			"script": "test:e2e:watch",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"options": {
				"env": {
					"NODE_ENV": "test",
					"PLAYWRIGHT_HTML_REPORT": "true"
				}
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"clear": true
			},
			"dependsOn": [
				"Dev: Next.js",
				"Dev: Socket server"
			]
		},
		{
			"label": "Dev: Next.js + Socket",
			"dependsOn": [
				"Dev: Next.js",
				"Dev: Socket server"
			],
			"dependsOrder": "parallel"
		},
		{
			"label": "Dev: E2E (Next + Playwright watch)",
			"type": "shell",
			"command": "npm run dev:e2e",
			"isBackground": true,
			"options": {
				"env": {
					"NODE_ENV": "test",
					"PLAYWRIGHT_HTML_REPORT": "true"
				}
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"clear": true
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"dependsOn": [
				"Dev: Next.js",
				"Dev: Socket server"
			]
		},
		{
			"label": "CI: Lint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "CI: Test",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "CI: Build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "CI: Build (verify)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify: Build clean",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "CI: Lint (post-hardening)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "CI: Test (post-hardening)",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Verify: Lint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify: Test",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}