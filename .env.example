# مثال لملف متغيرات البيئة
# قم بتعديله وفقًا للبيئة الخاصة بك

# سلسلة الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# سر JWT (إلزامي في الإنتاج). يفضّل 32+ حرف عشوائي.
JWT_SECRET=

# Optional hardening: if set, tokens are signed/verified with these claims.
JWT_ISSUER=
JWT_AUDIENCE=

# إعدادات Next.js عامة
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# إعدادات مصادقة / مفاتيح 3rd-party (مثال)
NEXT_PUBLIC_OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# إعدادات Socket (إن وُجدت)
SOCKET_URL=ws://localhost:3001

# بديل عملي لإعداد socket-server.js (المستخدم فعليًا في السكربت)
# المنفذ الافتراضي 4000
SOCKET_PORT=4000

# تفعيل سجلات Socket التفصيلية (0/1)
DEBUG_SOCKET=0

# (مستحسن في الإنتاج) Redis لتخزين revocation بدل ملف JSON
REDIS_URL=

# عنوان خدمة نموذج الذكاء الاصطناعي (FastAPI)
# يستخدمه /api/predict كـ proxy
PY_MODEL_URL=http://127.0.0.1:8000/predict

# Overrides optional (لـ scripts/check-model-server.mjs)
MODEL_HEALTH_URL=
MODEL_HEALTH_TIMEOUT_MS=30000

# حدود رفع الملفات (بايت). الافتراضي 10MB إذا لم يُحدد.
# ملاحظة: يوجد أكثر من مسار يستخدم اسم متغير مختلف.
MAX_UPLOAD_BYTES=10485760

# تفعيل روابط موقّعة لملفات /uploads (اختياري)
ENABLE_SIGNED_URLS=0
UPLOAD_URL_EXP_MS=300000

# إعدادات S3 (اختياري) — تُستخدم عند رفع ملفات الدردشة عبر presigned URLs
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# تفعيل logs التشخيصية (لا تفعلها في الإنتاج إلا عند الحاجة)
DEBUG_PROXY=0
DEBUG_AUTH=0
